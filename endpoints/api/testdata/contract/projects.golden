== create
POST /api/project
201 application/json; charset=utf-8
{
  "id": 2,
  "createdAt": "<time>",
  "deletedAt": null,
  "identifier": "new-project",
  "name": "New Project",
  "companyId": 0,
  "accessTokens": null,
  "users": null,
  "apps": null
}

== create without name
POST /api/project
400 application/json; charset=utf-8
{
  "message": "the project needs a name"
}

== create malformed
POST /api/project
400 application/json; charset=utf-8
{
  "message": "unexpected EOF"
}

