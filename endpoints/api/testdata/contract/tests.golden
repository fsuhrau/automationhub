== update without name
PUT /api/proj/app/1/test/1
400 application/json; charset=utf-8
{
  "message": "the test needs a name"
}

== run unknown test
POST /api/proj/app/1/test/99/run
404 application/json; charset=utf-8
{
  "message": "not found: test 99"
}

== run invalid test id
POST /api/proj/app/1/test/abc/run
400 application/json; charset=utf-8
{
  "message": "invalid test id"
}

== cancel finished run
POST /api/proj/app/1/test/1/run/1/cancel
404 application/json; charset=utf-8
{
  "message": "not found: no active runner for test run 1"
}

== cancel invalid run id
POST /api/proj/app/1/test/1/run/abc/cancel
400 application/json; charset=utf-8
{
  "message": "invalid run id"
}

