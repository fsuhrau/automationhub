== token create
POST /api/proj/settings/access_token
201 application/json; charset=utf-8
{
  "id": 2,
  "createdAt": "<time>",
  "deletedAt": null,
  "projectId": 1,
  "project": null,
  "nodeId": null,
  "node": null,
  "userId": null,
  "hint": "<generated>",
  "lastUsedAt": null,
  "name": "deploy",
  "token": "<generated>",
  "expiresAt": null
}

== token create without name
POST /api/proj/settings/access_token
400 application/json; charset=utf-8
{
  "message": "the token needs a name"
}

== token delete
DELETE /api/proj/settings/access_token/1
200 


== token delete unknown
DELETE /api/proj/settings/access_token/99
404 application/json; charset=utf-8
{
  "message": "token 99 not found"
}

