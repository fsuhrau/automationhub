== get lock
GET /api/proj/device/1/lock
200 application/json; charset=utf-8
{
  "locked": false,
  "lockedByTest": false
}

== lock
POST /api/proj/device/1/lock
200 application/json; charset=utf-8
{
  "deviceId": "dev-1",
  "token": "<generated>",
  "owner": "anonymous",
  "acquiredAt": "<time>",
  "lastUsed": "<time>",
  "expiresAt": "<time>"
}

== release without lease
DELETE /api/proj/device/1/lock
409 application/json; charset=utf-8
{
  "message": "device lease is invalid or expired"
}

== screenshot
GET /api/proj/device/1/screenshot
200 text/plain; charset=utf-8


== stream
GET /api/proj/device/1/stream
200

== video
GET /api/proj/device/1/video
400

== hierarchy
GET /api/proj/device/1/hierarchy
409 application/json; charset=utf-8
{
  "message": "no app connected to the device (dev-1); start the app first"
}

== logs
GET /api/proj/device/1/logs
200 application/json; charset=utf-8
{
  "lines": []
}

== logs stream
GET /api/proj/device/1/logs/stream
200

