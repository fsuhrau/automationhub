== app install
POST /api/proj/device/1/app/install
400 application/json; charset=utf-8
{
  "message": "Key: 'appRequest.BinaryID' Error:Field validation for 'BinaryID' failed on the 'required' tag"
}

== app start
POST /api/proj/device/1/app/start
400 application/json; charset=utf-8
{
  "message": "Key: 'appRequest.BinaryID' Error:Field validation for 'BinaryID' failed on the 'required' tag"
}

== app stop
POST /api/proj/device/1/app/stop
400 application/json; charset=utf-8
{
  "message": "Key: 'appRequest.BinaryID' Error:Field validation for 'BinaryID' failed on the 'required' tag"
}

== device not connected
GET /api/proj/device/1/lock
409 application/json; charset=utf-8
{
  "message": "device dev-1 is not connected"
}

== unknown device
POST /api/proj/device/99/tap
404 application/json; charset=utf-8
{
  "message": "device 99 not found"
}

